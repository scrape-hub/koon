\item{\code{status}, \code{status_code}}{Integer HTTP status code (e.g. 200).}
\item{\code{ok}}{\code{TRUE} when the status is 2xx.}
\item{\code{version}}{HTTP version: \code{"HTTP/1.1"}, \code{"h2"} or \code{"h3"}.}
\item{\code{url}}{Final URL after redirects.}
\item{\code{body}}{Raw vector with the body bytes.}
\item{\code{text}}{The body as a string, decoded with the charset of the
Content-Type (UTF-8 if none), or \code{NULL} for a binary body: a binary
